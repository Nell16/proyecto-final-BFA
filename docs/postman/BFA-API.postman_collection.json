{
  "info": {
    "name": "BFA Digital - API",
    "description": "Coleccion del Taller 4. Poner la contrasena en la variable adminPassword (no se guarda en el repositorio). Ejecutar primero 1. Login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Login (obtiene el token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{adminUser}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Codigo de estado 200 (igual al documentado en Swagger)', function () { pm.response.to.have.status(200); });",
              "const j = pm.response.json();",
              "pm.test('Estructura igual a la documentada: success, data, message, error, correlationId', function () {",
              "  pm.expect(j).to.have.property('success', true);",
              "  pm.expect(j).to.have.property('data');",
              "});",
              "const d = j.data;",
              "pm.test('data trae accessToken, tokenType, expiresAt, userId, username y permissions', function () {",
              "  pm.expect(d.accessToken).to.be.a('string').and.not.empty;",
              "  pm.expect(d.tokenType).to.eql('Bearer');",
              "  pm.expect(d.expiresAt).to.be.a('string');",
              "  pm.expect(d.userId).to.be.a('string');",
              "  pm.expect(d.username).to.be.a('string');",
              "  pm.expect(d.permissions).to.be.an('array');",
              "});",
              "pm.collectionVariables.set('token', d.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "1b. Login con credenciales incorrectas (caso de error 401)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{adminUser}}\",\n  \"password\": \"clave-incorrecta\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Codigo de estado 401', function () { pm.response.to.have.status(401); });",
              "pm.test('Estructura de error: success=false y error.code', function () {",
              "  const j = pm.response.json();",
              "  pm.expect(j.success).to.eql(false);",
              "  pm.expect(j.error).to.have.property('code');",
              "  pm.expect(j.error).to.have.property('message');",
              "});"
            ]
          }
        }
      ]
    },
