{
  "info": {
    "name": "BFA Digital - API",
    "description": "Coleccion del Taller 4. Poner la contrasena en la variable adminPassword (no se guarda en el repositorio). Ejecutar primero 1. Login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Login (obtiene el token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{adminUser}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Codigo de estado 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Estructura: success=true', function () { pm.expect(pm.response.json().success).to.eql(true); });",
              "const d = pm.response.json().data;",
              "pm.test('Trae accessToken, tokenType y permissions', function () { pm.expect(d).to.have.property('accessToken'); pm.expect(d.tokenType).to.eql('Bearer'); pm.expect(d.permissions).to.be.an('array'); });",
              "pm.collectionVariables.set('token', d.accessToken);"
            ]
          }
        }
      ]
    },
